NODE_ENV=development
PORT=3010
APP_ORIGIN=http://127.0.0.1:3010
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/date_me_maybe
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SHARE_TOKEN_SECRET=
# Local development only. Accepts *.test addresses and never sends real mail.
DEV_MAILBOX=1
# Optional Google OAuth: callback is APP_ORIGIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live email login requires a verified Resend domain. Disable DEV_MAILBOX first.
RESEND_API_KEY=
EMAIL_FROM=见一面 <hello@opendater.com>
