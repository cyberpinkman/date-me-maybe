{
  "name": "date-me-maybe",
  "version": "0.4.0",
  "private": true,
  "description": "见一面：俏皮可爱的暧昧期邀约小工具，带连续逃跑按钮和完整收邀情境。",
  "license": "MIT",
  "author": "cyberpinkman",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env server/start.mjs",
    "build": "node scripts/build.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test tests/*.test.js tests/auth-*.test.mjs tests/client-ip.test.mjs",
    "test:integration": "node --test tests/server.integration.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberpinkman/date-me-maybe.git"
  },
  "bugs": {
    "url": "https://github.com/cyberpinkman/date-me-maybe/issues"
  },
  "homepage": "https://github.com/cyberpinkman/date-me-maybe#readme",
  "keywords": [
    "dating",
    "invitation",
    "interactive",
    "vanilla-js",
    "prototype"
  ],
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "pg": "8.23.1"
  }
}
